{
  "expo": {
    "name": "NASUHA",
    "slug": "nasjak-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/nasuha_app_icon_01.png",
    "userInterfaceStyle": "automatic",
    "scheme": "nasjak",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nasuha.nasjak",
      "infoPlist": {
        "NSCameraUsageDescription": "NASUHA App membutuhkan akses kamera untuk mengambil foto profil.",
        "NSPhotoLibraryUsageDescription": "NASUHA App membutuhkan akses galeri untuk memilih foto profil.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/nasuha_app_icon_01.png",
        "backgroundColor": "#F5F8F8"
      },
      "package": "com.nasuha.nasjak",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA7hD3l5ATf2Wf2D8HZ-MoWyDj4sdVp1RE"
        }
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F8F8"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#00B4D8",
          "defaultChannel": "reminders",
          "sounds": [
            "./assets/nas_1.mp3",
            "./assets/adhan.mp3"
          ],
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan NASUHA menggunakan lokasi Anda untuk waktu shalat, arah kiblat, dan masjid terdekat."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NASUHA App membutuhkan akses galeri untuk memilih foto profil.",
          "cameraPermission": "NASUHA App membutuhkan akses kamera untuk mengambil foto profil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Izinkan NASUHA menampilkan masjid terdekat dan membantu menentukan arah kiblat."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6987a08-ba13-4375-83de-976b29c54af0"
      }
    }
  }
}
