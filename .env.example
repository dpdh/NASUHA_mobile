# Google OAuth client IDs from Google Cloud Console.
# These are public client IDs, not private secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Backend nasjak-backend (wajib). Contoh lokal: http://localhost:3100/api/v1 (web),
# http://10.0.2.2:3100/api/v1 (emulator Android), http://<IP-LAN>:3100/api/v1 (HP fisik).
# Do not put Gmail passwords, OAuth client secrets, or Play Console service-account JSON here.
EXPO_PUBLIC_API_BASE_URL=https://api.nasuha.id/api/v1
EXPO_PUBLIC_USER_PROVIDER=api

# EAS Submit uses a Play Console service account configured in EAS Secrets,
# not in the mobile app. See the project release documentation.
